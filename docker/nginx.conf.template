server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  auth_basic "Hajimimi";
  auth_basic_user_file /etc/nginx/.htpasswd;

  location /v1/ {
    proxy_pass https://haqimi.uk/v1/;
    proxy_ssl_server_name on;
    proxy_set_header Host haqimi.uk;
    proxy_set_header Authorization "Bearer ${CHAT_API_KEY}";
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 300s;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
